# DRAFT (see drafts/README.md): moves to packages/rmpp-lang/ when rmpp-lang v0.1.0 is released; fill in sha512sums.
maintainer="lorancecall <84116812+lorancecall@users.noreply.github.com>"
pkgname=rmpp-lang
pkgver=0.1.0
pkgrel=0
upstream_author="lorancecall"
category="ui"
pkgdesc="Languages: keyboard switching and fonts per language (typed text too); languages are add-ons (rmpp-lang-ko, ...)"
url="https://github.com/lorancecall/rmpp-lang"
arch="aarch64"
license="GPL-3.0-only"
# !rmpp-korean: the old Korean add-on would compose Hangul a second time (remove it first: vellum del rmpp-korean)
depends="rmpp-preload !rm1 !rm2 !rmpp-korean mount-utils remarkable-os>=3.29 remarkable-os<3.30"
source="
https://github.com/$upstream_author/rmpp-lang/releases/download/v$pkgver/librmpp-lang.so
https://github.com/$upstream_author/rmpp-lang/releases/download/v$pkgver/rmpp-lang.rcc
https://github.com/$upstream_author/rmpp-lang/releases/download/v$pkgver/rmpp-lang
https://raw.githubusercontent.com/$upstream_author/rmpp-lang/v$pkgver/LICENSE
"
options="!check !fhs !strip"

# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.
# Language add-ons are separate packages rmpp-lang-<code> (scripts/lang-addons.py); they put <code>.rcc into
# /usr/lib/rmpp-lang/languages/, which this package creates.

package() {
	install -Dm755 "$srcdir"/librmpp-lang.so "$pkgdir"/home/root/.vellum/share/rmpp-lang/librmpp-lang.so
	install -Dm644 "$srcdir"/rmpp-lang.rcc "$pkgdir"/home/root/.vellum/share/rmpp-lang/rmpp-lang.rcc
	install -Dm755 "$srcdir"/rmpp-lang "$pkgdir"/home/root/.vellum/share/rmpp-lang/rmpp-lang

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rmpp-lang" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p /usr/lib/rmpp-lang/languages
	cp /home/root/.vellum/share/rmpp-lang/librmpp-lang.so /usr/lib/rmpp-lang/librmpp-lang.so.new && chmod 755 /usr/lib/rmpp-lang/librmpp-lang.so.new && mv -f /usr/lib/rmpp-lang/librmpp-lang.so.new /usr/lib/rmpp-lang/librmpp-lang.so
	cp /home/root/.vellum/share/rmpp-lang/rmpp-lang.rcc /usr/lib/rmpp-lang/rmpp-lang.rcc.new && chmod 644 /usr/lib/rmpp-lang/rmpp-lang.rcc.new && mv -f /usr/lib/rmpp-lang/rmpp-lang.rcc.new /usr/lib/rmpp-lang/rmpp-lang.rcc
	cp /home/root/.vellum/share/rmpp-lang/rmpp-lang /usr/bin/rmpp-lang.new && chmod 755 /usr/bin/rmpp-lang.new && mv -f /usr/bin/rmpp-lang.new /usr/bin/rmpp-lang
	mkdir -p /usr/lib/rmpp-preload.d
	ln -sf /usr/lib/rmpp-lang/librmpp-lang.so /usr/lib/rmpp-preload.d/50-rmpp-lang.so
	sync
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}

postupgrade() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p /usr/lib/rmpp-lang/languages
	cp /home/root/.vellum/share/rmpp-lang/librmpp-lang.so /usr/lib/rmpp-lang/librmpp-lang.so.new && chmod 755 /usr/lib/rmpp-lang/librmpp-lang.so.new && mv -f /usr/lib/rmpp-lang/librmpp-lang.so.new /usr/lib/rmpp-lang/librmpp-lang.so
	cp /home/root/.vellum/share/rmpp-lang/rmpp-lang.rcc /usr/lib/rmpp-lang/rmpp-lang.rcc.new && chmod 644 /usr/lib/rmpp-lang/rmpp-lang.rcc.new && mv -f /usr/lib/rmpp-lang/rmpp-lang.rcc.new /usr/lib/rmpp-lang/rmpp-lang.rcc
	cp /home/root/.vellum/share/rmpp-lang/rmpp-lang /usr/bin/rmpp-lang.new && chmod 755 /usr/bin/rmpp-lang.new && mv -f /usr/bin/rmpp-lang.new /usr/bin/rmpp-lang
	mkdir -p /usr/lib/rmpp-preload.d
	ln -sf /usr/lib/rmpp-lang/librmpp-lang.so /usr/lib/rmpp-preload.d/50-rmpp-lang.so
	sync
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}

# `vellum reenable` after an OS update: the root file system is already writable here. The add-on packages
# copy their own .rcc files back in their postosupgrade.
postosupgrade() {
	mkdir -p /usr/lib/rmpp-lang/languages
	cp /home/root/.vellum/share/rmpp-lang/librmpp-lang.so /usr/lib/rmpp-lang/librmpp-lang.so.new && chmod 755 /usr/lib/rmpp-lang/librmpp-lang.so.new && mv -f /usr/lib/rmpp-lang/librmpp-lang.so.new /usr/lib/rmpp-lang/librmpp-lang.so
	cp /home/root/.vellum/share/rmpp-lang/rmpp-lang.rcc /usr/lib/rmpp-lang/rmpp-lang.rcc.new && chmod 644 /usr/lib/rmpp-lang/rmpp-lang.rcc.new && mv -f /usr/lib/rmpp-lang/rmpp-lang.rcc.new /usr/lib/rmpp-lang/rmpp-lang.rcc
	cp /home/root/.vellum/share/rmpp-lang/rmpp-lang /usr/bin/rmpp-lang.new && chmod 755 /usr/bin/rmpp-lang.new && mv -f /usr/bin/rmpp-lang.new /usr/bin/rmpp-lang
	mkdir -p /usr/lib/rmpp-preload.d
	ln -sf /usr/lib/rmpp-lang/librmpp-lang.so /usr/lib/rmpp-preload.d/50-rmpp-lang.so
	sync
}

# Settings (/home/root/.config/rmpp-lang) and the user's fonts stay, so a reinstall finds them again.
predeinstall() {
	/home/root/.vellum/bin/mount-rw
	rm -f /usr/lib/rmpp-preload.d/50-rmpp-lang.so
	rm -rf /usr/lib/rmpp-lang
	rm -f /usr/bin/rmpp-lang
	sync
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}
