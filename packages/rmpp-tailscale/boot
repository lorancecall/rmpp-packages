#!/bin/sh
# rmpp-tailscale boot hook: rmpp-preload's launcher runs it once per boot (and the package scripts after installing).
# The units go to /run/systemd/system (RAM): nothing on the root file system. Settings > Tailscale keeps using
# `systemctl start/stop rmpp-tailscaled.service`; the unit only starts when the flag file in /home says so.
S=/home/root/.vellum/share/rmpp-tailscale
mkdir -p /run/systemd/system
for u in rmpp-tailscaled.service rmpp-tailscale-ssh.socket rmpp-tailscale-ssh@.service; do
	cp "$S/$u" "/run/systemd/system/$u.new" && mv -f "/run/systemd/system/$u.new" "/run/systemd/system/$u"
done
systemctl daemon-reload
systemctl --no-block start rmpp-tailscaled.service
