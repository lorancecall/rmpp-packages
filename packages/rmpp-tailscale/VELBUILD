# `vellum reenable` after an OS update: the root file system is already writable here.
postosupgrade() {
	s=/home/root/.vellum/share/rmpp-tailscale
	mkdir -p /usr/lib/rmpp-tailscale /usr/lib/rmpp-preload.d /usr/lib/systemd/system/multi-user.target.wants
	cp "$s"/librmpp-tailscale.so /usr/lib/rmpp-tailscale/librmpp-tailscale.so.new && chmod 755 /usr/lib/rmpp-tailscale/librmpp-tailscale.so.new && mv -f /usr/lib/rmpp-tailscale/librmpp-tailscale.so.new /usr/lib/rmpp-tailscale/librmpp-tailscale.so
	cp "$s"/rmpp-tailscale.rcc /usr/lib/rmpp-tailscale/rmpp-tailscale.rcc.new && chmod 644 /usr/lib/rmpp-tailscale/rmpp-tailscale.rcc.new && mv -f /usr/lib/rmpp-tailscale/rmpp-tailscale.rcc.new /usr/lib/rmpp-tailscale/rmpp-tailscale.rcc
	cp "$s"/rmpp-tailscaled.service /usr/lib/systemd/system/rmpp-tailscaled.service.new && chmod 644 /usr/lib/systemd/system/rmpp-tailscaled.service.new && mv -f /usr/lib/systemd/system/rmpp-tailscaled.service.new /usr/lib/systemd/system/rmpp-tailscaled.service
	cp "$s"/rmpp-tailscale-ssh.socket /usr/lib/systemd/system/rmpp-tailscale-ssh.socket.new && chmod 644 /usr/lib/systemd/system/rmpp-tailscale-ssh.socket.new && mv -f /usr/lib/systemd/system/rmpp-tailscale-ssh.socket.new /usr/lib/systemd/system/rmpp-tailscale-ssh.socket
	cp "$s"/rmpp-tailscale-ssh@.service /usr/lib/systemd/system/rmpp-tailscale-ssh@.service.new && chmod 644 /usr/lib/systemd/system/rmpp-tailscale-ssh@.service.new && mv -f /usr/lib/systemd/system/rmpp-tailscale-ssh@.service.new /usr/lib/systemd/system/rmpp-tailscale-ssh@.service
	ln -sf ../rmpp-tailscaled.service /usr/lib/systemd/system/multi-user.target.wants/rmpp-tailscaled.service
	ln -sf /usr/lib/rmpp-tailscale/librmpp-tailscale.so /usr/lib/rmpp-preload.d/50-rmpp-tailscale.so
	sync
}

predeinstall() {
	systemctl stop rmpp-tailscaled.service 2>/dev/null || true
	/home/root/.vellum/bin/mount-rw
	rm -f /usr/lib/rmpp-preload.d/50-rmpp-tailscale.so
	rm -f /usr/lib/systemd/system/multi-user.target.wants/rmpp-tailscaled.service
	systemctl stop rmpp-tailscale-ssh.socket 2>/dev/null || true
	rm -f /usr/lib/systemd/system/rmpp-tailscaled.service /usr/lib/systemd/system/rmpp-tailscale-ssh.socket /usr/lib/systemd/system/rmpp-tailscale-ssh@.service
	rm -rf /usr/lib/rmpp-tailscale
	sync
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/rmpp-tailscale /home/root/.local/share/rmpp-tailscale
	fi
}
