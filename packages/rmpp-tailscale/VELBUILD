category="network"
pkgdesc="Tailscale (userspace networking) with a Settings page: on/off, QR-code login, status and devices"
url="https://github.com/lorancecall/rmpp-tailscale"
arch="aarch64"
license="GPL-3.0-only AND BSD-3-Clause AND MIT"
depends="rmpp-preload !rm1 !rm2 mount-utils remarkable-os>=3.29 remarkable-os<3.30 !tailscale"
source="
https://github.com/$upstream_author/rmpp-tailscale/releases/download/v$pkgver/librmpp-tailscale.so
https://github.com/$upstream_author/rmpp-tailscale/releases/download/v$pkgver/rmpp-tailscale.rcc
https://raw.githubusercontent.com/$upstream_author/rmpp-tailscale/v$pkgver/LICENSE
https://pkgs.tailscale.com/stable/tailscale_${_tsver}_arm64.tgz
rmpp-tailscaled.service
rmpp-tailscale-ssh.socket
rmpp-tailscale-ssh@.service
boot
rmpp-tailscale.env
"
options="!check !fhs !strip"

# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.
# Everything lives in /home (rmpp-preload's one-file layout): UI library, rcc, units and the Tailscale binaries
# (~70 MB) in the share folder, a link in preload.d, the rcc path in env.d, and a boot hook in boot.d that copies
# the units to /run/systemd/system (RAM) at every boot. A factory reset removes it all. Older versions put files
# in /usr/lib and /usr/lib/systemd/system: removed here.
# SSH: rmpp-tailscale-ssh.socket listens on lo (tailscaled hands incoming connections to loopback).
# Tailscale starts off; it is turned on from Settings > Tailscale (flag file in /home/root/.config/rmpp-tailscale).

package() {
	local d="$pkgdir"/home/root/.vellum/share/rmpp-tailscale
	local p="$pkgdir"/home/root/.vellum/share/rmpp-preload
	install -Dm755 "$srcdir"/librmpp-tailscale.so "$d"/librmpp-tailscale.so
	install -Dm644 "$srcdir"/rmpp-tailscale.rcc "$d"/rmpp-tailscale.rcc
	install -Dm644 "$srcdir"/rmpp-tailscaled.service "$d"/rmpp-tailscaled.service
	install -Dm644 "$srcdir"/rmpp-tailscale-ssh.socket "$d"/rmpp-tailscale-ssh.socket
	install -Dm644 "$srcdir"/rmpp-tailscale-ssh@.service "$d"/rmpp-tailscale-ssh@.service
	install -Dm755 "$srcdir"/tailscale_${_tsver}_arm64/tailscale "$d"/tailscale
	install -Dm755 "$srcdir"/tailscale_${_tsver}_arm64/tailscaled "$d"/tailscaled
	install -dm755 "$p"/preload.d
	ln -s ../../rmpp-tailscale/librmpp-tailscale.so "$p"/preload.d/50-rmpp-tailscale.so
	install -Dm644 "$srcdir"/rmpp-tailscale.env "$p"/env.d/rmpp-tailscale.env
	install -Dm755 "$srcdir"/boot "$p"/boot.d/50-rmpp-tailscale

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	printf '%s\n' "https://github.com/$upstream_author/rmpp-tailscale" "https://github.com/tailscale/tailscale (BSD-3-Clause)" \
		"https://github.com/nayuki/QR-Code-generator (MIT)" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	if [ -e /usr/lib/rmpp-tailscale ] || [ -e /usr/lib/systemd/system/rmpp-tailscaled.service ]; then
		/home/root/.vellum/bin/mount-rw
		rm -f /usr/lib/rmpp-preload.d/50-rmpp-tailscale.so /usr/lib/systemd/system/multi-user.target.wants/rmpp-tailscaled.service
		rm -f /usr/lib/systemd/system/rmpp-tailscaled.service /usr/lib/systemd/system/rmpp-tailscale-ssh.socket /usr/lib/systemd/system/rmpp-tailscale-ssh@.service
		rm -rf /usr/lib/rmpp-tailscale
		sync
		/home/root/.vellum/share/rmpp-preload/boot.d/50-rmpp-tailscale
		systemctl try-restart rmpp-tailscaled.service 2>/dev/null || true
		systemctl reset-failed xochitl 2>/dev/null || true
		systemctl restart xochitl
		sleep 3
		/home/root/.vellum/bin/mount-restore
	else
		/home/root/.vellum/share/rmpp-preload/boot.d/50-rmpp-tailscale
		systemctl try-restart rmpp-tailscaled.service 2>/dev/null || true
		systemctl reset-failed xochitl 2>/dev/null || true
		systemctl restart xochitl
	fi
}

postupgrade() {
	if [ -e /usr/lib/rmpp-tailscale ] || [ -e /usr/lib/systemd/system/rmpp-tailscaled.service ]; then
		/home/root/.vellum/bin/mount-rw
		rm -f /usr/lib/rmpp-preload.d/50-rmpp-tailscale.so /usr/lib/systemd/system/multi-user.target.wants/rmpp-tailscaled.service
		rm -f /usr/lib/systemd/system/rmpp-tailscaled.service /usr/lib/systemd/system/rmpp-tailscale-ssh.socket /usr/lib/systemd/system/rmpp-tailscale-ssh@.service
		rm -rf /usr/lib/rmpp-tailscale
		sync
		/home/root/.vellum/share/rmpp-preload/boot.d/50-rmpp-tailscale
		systemctl try-restart rmpp-tailscaled.service 2>/dev/null || true
		systemctl reset-failed xochitl 2>/dev/null || true
		systemctl restart xochitl
		sleep 3
		/home/root/.vellum/bin/mount-restore
	else
		/home/root/.vellum/share/rmpp-preload/boot.d/50-rmpp-tailscale
		systemctl try-restart rmpp-tailscaled.service 2>/dev/null || true
		systemctl reset-failed xochitl 2>/dev/null || true
		systemctl restart xochitl
	fi
}

predeinstall() {
	systemctl stop rmpp-tailscaled.service 2>/dev/null || true
	systemctl stop rmpp-tailscale-ssh.socket 2>/dev/null || true
	rm -f /run/systemd/system/rmpp-tailscaled.service /run/systemd/system/rmpp-tailscale-ssh.socket /run/systemd/system/rmpp-tailscale-ssh@.service
	systemctl daemon-reload
}

postdeinstall() {
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/rmpp-tailscale /home/root/.local/share/rmpp-tailscale
	fi
}
