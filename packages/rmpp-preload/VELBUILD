pkgname=rmpp-preload
pkgver=0.2.0
pkgrel=0
upstream_author="lorancecall"
category="framework"
pkgdesc="Loads rmpp add-ons into xochitl at boot from /home; one file on the root file system"
url="https://github.com/lorancecall/rmpp-packages"
arch="noarch"
license="GPL-3.0-only"
depends="!rm1 !rm2 mount-utils remarkable-os>=3.29 remarkable-os<3.30"
source="
launch
rmpp-preload.conf
"
options="!check !fhs"

package() {
	install -Dm755 "$srcdir"/launch "$pkgdir"/home/root/.vellum/share/rmpp-preload/launch
	install -Dm644 "$srcdir"/rmpp-preload.conf "$pkgdir"/home/root/.vellum/share/rmpp-preload/rmpp-preload.conf
	# the add-ons put their files here (in /home: a factory reset removes them with Vellum)
	install -dm755 "$pkgdir"/home/root/.vellum/share/rmpp-preload/preload.d "$pkgdir"/home/root/.vellum/share/rmpp-preload/env.d "$pkgdir"/home/root/.vellum/share/rmpp-preload/boot.d
}

# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.
# The only file on the root file system is xochitl's drop-in (/usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf): it runs the launcher in /home when it is
# there and plain xochitl when it is not, so a factory reset (which wipes /home) leaves a stock tablet.

postinstall() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p "$(dirname /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf)"
	cp /home/root/.vellum/share/rmpp-preload/rmpp-preload.conf /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && chmod 644 /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && mv -f /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf
	# older layout: the launcher lived in /usr/lib; /usr/lib/rmpp-preload.d stays while hand-made installs use it
	rm -rf /usr/lib/rmpp-preload
	rmdir /usr/lib/rmpp-preload.d 2>/dev/null || true
	sync
	/home/root/.vellum/bin/mount-restore
	# No restart here: the add-on packages that depend on this one restart xochitl after installing.
	systemctl daemon-reload
}

postupgrade() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p "$(dirname /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf)"
	cp /home/root/.vellum/share/rmpp-preload/rmpp-preload.conf /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && chmod 644 /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && mv -f /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf
	# older layout: the launcher lived in /usr/lib; /usr/lib/rmpp-preload.d stays while hand-made installs use it
	rm -rf /usr/lib/rmpp-preload
	rmdir /usr/lib/rmpp-preload.d 2>/dev/null || true
	sync
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}

# `vellum reenable` after an OS update: the root file system is already writable here.
postosupgrade() {
	mkdir -p "$(dirname /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf)"
	cp /home/root/.vellum/share/rmpp-preload/rmpp-preload.conf /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && chmod 644 /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && mv -f /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf
	sync
	systemctl daemon-reload
}

predeinstall() {
	/home/root/.vellum/bin/mount-rw
	rm -f /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf
	rm -rf /usr/lib/rmpp-preload
	rmdir /usr/lib/rmpp-preload.d 2>/dev/null || true
	sync
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}
