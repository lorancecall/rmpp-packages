options="!check !fhs"

# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.
# Layout: everything rmpp puts on the root file system is under /usr/lib/rmpp (launcher, restart helper, each
# add-on's folder, preload.d, env.d, boot.d, units). The only file outside it is xochitl's drop-in
# /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf. Removing both removes every rmpp system file.
# Plain `mount -o remount,rw|ro /`: Vellum's mount-rw unmounts /etc recursively, which also drops the
# /etc/dropbear bind mount (SSH host key) until the next boot.

package() {
	install -Dm755 "$srcdir"/launch "$pkgdir"/home/root/.vellum/share/rmpp-preload/launch
	install -Dm755 "$srcdir"/restart "$pkgdir"/home/root/.vellum/share/rmpp-preload/restart
	install -Dm644 "$srcdir"/rmpp-preload.conf "$pkgdir"/home/root/.vellum/share/rmpp-preload/rmpp-preload.conf
}

postinstall() {
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/preload.d /usr/lib/rmpp/env.d /usr/lib/rmpp/boot.d /usr/lib/rmpp/units /usr/lib/systemd/system/xochitl.service.d
	cp /home/root/.vellum/share/rmpp-preload/launch /usr/lib/rmpp/launch.new && chmod 755 /usr/lib/rmpp/launch.new && mv -f /usr/lib/rmpp/launch.new /usr/lib/rmpp/launch
	cp /home/root/.vellum/share/rmpp-preload/restart /usr/lib/rmpp/restart.new && chmod 755 /usr/lib/rmpp/restart.new && mv -f /usr/lib/rmpp/restart.new /usr/lib/rmpp/restart
	cp /home/root/.vellum/share/rmpp-preload/rmpp-preload.conf /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && chmod 644 /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && mv -f /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf
	# older layout: the launcher was /usr/lib/rmpp-preload/launch (a script, never loaded as a library);
	# /usr/lib/rmpp-preload.d stays while older add-on versions or hand-made installs still link into it
	rm -rf /usr/lib/rmpp-preload
	rmdir /usr/lib/rmpp-preload.d 2>/dev/null || true
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	systemctl daemon-reload
	# No restart here: the add-on packages installed with it restart xochitl once, after the last of them.
}

postupgrade() {
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/preload.d /usr/lib/rmpp/env.d /usr/lib/rmpp/boot.d /usr/lib/rmpp/units /usr/lib/systemd/system/xochitl.service.d
	cp /home/root/.vellum/share/rmpp-preload/launch /usr/lib/rmpp/launch.new && chmod 755 /usr/lib/rmpp/launch.new && mv -f /usr/lib/rmpp/launch.new /usr/lib/rmpp/launch
	cp /home/root/.vellum/share/rmpp-preload/restart /usr/lib/rmpp/restart.new && chmod 755 /usr/lib/rmpp/restart.new && mv -f /usr/lib/rmpp/restart.new /usr/lib/rmpp/restart
	cp /home/root/.vellum/share/rmpp-preload/rmpp-preload.conf /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && chmod 644 /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && mv -f /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf
	# older layout: the launcher was /usr/lib/rmpp-preload/launch (a script, never loaded as a library);
	# /usr/lib/rmpp-preload.d stays while older add-on versions or hand-made installs still link into it
	rm -rf /usr/lib/rmpp-preload
	rmdir /usr/lib/rmpp-preload.d 2>/dev/null || true
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	systemctl daemon-reload
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

# `vellum reenable` after an OS update: the root file system is already writable here. The add-ons copy their
# own files back in their postosupgrade; the restart then runs the launcher and the boot hooks.
postosupgrade() {
	mkdir -p /usr/lib/rmpp/preload.d /usr/lib/rmpp/env.d /usr/lib/rmpp/boot.d /usr/lib/rmpp/units /usr/lib/systemd/system/xochitl.service.d
	cp /home/root/.vellum/share/rmpp-preload/launch /usr/lib/rmpp/launch.new && chmod 755 /usr/lib/rmpp/launch.new && mv -f /usr/lib/rmpp/launch.new /usr/lib/rmpp/launch
	cp /home/root/.vellum/share/rmpp-preload/restart /usr/lib/rmpp/restart.new && chmod 755 /usr/lib/rmpp/restart.new && mv -f /usr/lib/rmpp/restart.new /usr/lib/rmpp/restart
	cp /home/root/.vellum/share/rmpp-preload/rmpp-preload.conf /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && chmod 644 /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new && mv -f /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf.new /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf
	sync
	systemctl daemon-reload
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

# Last step of a removal (the add-ons that depend on it are removed first): drop the drop-in, restart xochitl so
# nothing is loaded from /usr/lib/rmpp any more, then delete the whole folder.
predeinstall() {
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	mount -o remount,rw /
	rm -f /usr/lib/systemd/system/xochitl.service.d/zz-rmpp-preload.conf
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	rm -rf /usr/lib/rmpp /usr/lib/rmpp-preload
	rmdir /usr/lib/rmpp-preload.d 2>/dev/null || true
	sync
	mount -o remount,ro / || echo "note: / is still read-write"
}
