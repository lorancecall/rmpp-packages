#!/bin/sh
# rmpp-preload launcher: /usr/lib/rmpp/launch. xochitl's drop-in (the only rmpp file outside /usr/lib/rmpp) runs it
# instead of xochitl when it exists. Everything rmpp puts on the root file system lives under /usr/lib/rmpp, so
# removing that folder and the drop-in removes all of it.
#
#  boot.d/*      run once per boot, in the background (load the Bluetooth driver, start Tailscale, ...)
#  env.d/*.env   sourced before xochitl starts (each add-on's resource paths, e.g. RMPPBT_RCC)
#  preload.d/*.so  added to LD_PRELOAD, with /usr/lib/rmpp-preload.d/*.so (hand-made and older installs)
# An LD_PRELOAD that is already set (for example xovi's) is kept in front.
# Runs before the encrypted /home is mounted: nothing here may wait for /home.
P=/usr/lib/rmpp

if [ ! -e /run/rmpp-preload.booted ]; then
	: > /run/rmpp-preload.booted
	for h in "$P"/boot.d/*; do
		[ -x "$h" ] && ("$h" >/dev/null 2>&1 &)
	done
fi

for e in "$P"/env.d/*.env; do
	[ -r "$e" ] && . "$e"
done

extra=""
for f in "$P"/preload.d/*.so /usr/lib/rmpp-preload.d/*.so; do
	[ -e "$f" ] && extra="$extra $(readlink -f "$f")"
done
extra=${extra# }
if [ -n "$extra" ]; then
	LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD }$extra"
	export LD_PRELOAD
fi
exec "$@"
