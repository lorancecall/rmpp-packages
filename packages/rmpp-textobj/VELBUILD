# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. Scripts never restart xochitl themselves: they re-arm
# the transient timer rmpp-restart-xochitl (15 s, runs /usr/lib/rmpp/restart), so a transaction restarts it once.
# Root file system: the UI library goes to /usr/lib/rmpp/rmpp-textobj with a link in preload.d (55: before
# rmpp-hwr's 60, which talks to it); a library xochitl may have loaded is renamed to *.old or moved to
# /usr/lib/rmpp/.trash, never deleted. Plain `mount -o remount,rw|ro /`: Vellum's mount-rw drops /etc/dropbear.
# glyphs.json (ASCII) stays in /home/root/.vellum/share/rmpp-textobj. The user's objects
# (/home/root/.local/share/rmpp-textobj) stay when the package is removed.

package() {
	install -Dm755 "$srcdir"/librmpp-textobj-ui.so "$pkgdir"/home/root/.vellum/share/rmpp-textobj/librmpp-textobj-ui.so
	install -Dm644 "$srcdir"/glyphs.json "$pkgdir"/home/root/.vellum/share/rmpp-textobj/glyphs.json
	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rmpp-textobj" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/rmpp-textobj /usr/lib/rmpp/preload.d
	cp /home/root/.vellum/share/rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new && chmod 755 /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new && { [ ! -e /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so ] || mv -f /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.old; } && mv -f /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so
	ln -sfn ../rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/preload.d/55-rmpp-textobj.so
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

postupgrade() {
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/rmpp-textobj /usr/lib/rmpp/preload.d
	cp /home/root/.vellum/share/rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new && chmod 755 /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new && { [ ! -e /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so ] || mv -f /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.old; } && mv -f /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so
	ln -sfn ../rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/preload.d/55-rmpp-textobj.so
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

# `vellum reenable` after an OS update: the root file system is already writable here; rmpp-preload's
# postosupgrade restarts xochitl.
postosupgrade() {
	mkdir -p /usr/lib/rmpp/rmpp-textobj /usr/lib/rmpp/preload.d
	cp /home/root/.vellum/share/rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new && chmod 755 /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new && { [ ! -e /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so ] || mv -f /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.old; } && mv -f /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so.new /usr/lib/rmpp/rmpp-textobj/librmpp-textobj-ui.so
	ln -sfn ../rmpp-textobj/librmpp-textobj-ui.so /usr/lib/rmpp/preload.d/55-rmpp-textobj.so
	sync
}

predeinstall() {
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/.trash
	rm -f /usr/lib/rmpp/preload.d/55-rmpp-textobj.so
	[ ! -e /usr/lib/rmpp/rmpp-textobj ] || mv /usr/lib/rmpp/rmpp-textobj /usr/lib/rmpp/.trash/rmpp-textobj.$$
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
	# `vellum purge` (rmpp setup: "Also delete their settings and data"): settings and data in /home too
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/rmpp-textobj /home/root/.local/share/rmpp-textobj
	fi
}
