# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. Scripts never restart xochitl themselves: they re-arm
# the transient timer rmpp-restart-xochitl (15 s, runs /usr/lib/rmpp/restart), so a transaction restarts it once.
# Root file system: everything under /usr/lib/rmpp (rmpp-preload's layout); a file xochitl may have loaded is
# renamed to *.old or moved to /usr/lib/rmpp/.trash, never deleted, and /usr/lib/rmpp/restart deletes it after the
# restart. Plain `mount -o remount,rw|ro /`: Vellum's mount-rw unmounts /etc recursively, which also drops the
# /etc/dropbear bind mount (SSH host key) until the next boot.
# Language add-ons (rmpp-lang-<code>, scripts/lang-addons.py) put their layouts in
# /usr/lib/rmpp/rmpp-lang/languages/ (next to rmpp-lang.rcc: needs rmpp-lang 0.3.2). Settings
# (/home/root/.config/rmpp-lang) and the user's fonts stay when it is removed.

package() {
	install -Dm755 "$srcdir"/librmpp-lang.so "$pkgdir"/home/root/.vellum/share/rmpp-lang/librmpp-lang.so
	install -Dm644 "$srcdir"/rmpp-lang.rcc "$pkgdir"/home/root/.vellum/share/rmpp-lang/rmpp-lang.rcc
	install -Dm755 "$srcdir"/rmpp-lang "$pkgdir"/home/root/.vellum/share/rmpp-lang/rmpp-lang
	echo "export RMPPLANG_RCC=/usr/lib/rmpp/rmpp-lang/rmpp-lang.rcc" > "$pkgdir"/home/root/.vellum/share/rmpp-lang/rmpp-lang.env
	install -dm755 "$pkgdir"/home/root/.vellum/bin
	ln -s /usr/lib/rmpp/rmpp-lang/rmpp-lang "$pkgdir"/home/root/.vellum/bin/rmpp-lang

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rmpp-lang" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	mount -o remount,rw /
	# older versions put files in /usr/lib/rmpp-lang, /usr/bin/rmpp-lang: set aside (deleted after the restart)
	if [ -e /usr/lib/rmpp-lang ] || [ -e /usr/bin/rmpp-lang ]; then
		mkdir -p /usr/lib/rmpp/.trash
		rm -f /usr/lib/rmpp-preload.d/50-rmpp-lang.so /usr/bin/rmpp-lang
		[ ! -e /usr/lib/rmpp-lang ] || mv /usr/lib/rmpp-lang /usr/lib/rmpp/.trash/usr_lib_rmpp-lang.$$
		[ ! -e /usr/bin/rmpp-lang ] || mv /usr/bin/rmpp-lang /usr/lib/rmpp/.trash/usr_bin_rmpp-lang.$$
	fi
	mkdir -p /usr/lib/rmpp/rmpp-lang /usr/lib/rmpp/preload.d /usr/lib/rmpp/env.d /usr/lib/rmpp/rmpp-lang/languages
	cp "/home/root/.vellum/share/rmpp-lang"/librmpp-lang.so /usr/lib/rmpp/rmpp-lang/librmpp-lang.so.new && chmod 755 /usr/lib/rmpp/rmpp-lang/librmpp-lang.so.new && { [ ! -e /usr/lib/rmpp/rmpp-lang/librmpp-lang.so ] || mv -f /usr/lib/rmpp/rmpp-lang/librmpp-lang.so /usr/lib/rmpp/rmpp-lang/librmpp-lang.so.old; } && mv -f /usr/lib/rmpp/rmpp-lang/librmpp-lang.so.new /usr/lib/rmpp/rmpp-lang/librmpp-lang.so
	cp "/home/root/.vellum/share/rmpp-lang"/rmpp-lang.rcc /usr/lib/rmpp/rmpp-lang/rmpp-lang.rcc.new && chmod 644 /usr/lib/rmpp/rmpp-lang/rmpp-lang.rcc.new && { [ ! -e /usr/lib/rmpp/rmpp-lang/rmpp-lang.rcc ] || mv -f /usr/lib/rmpp/rmpp-lang/rmpp-lang.rcc /usr/lib/rmpp/rmpp-lang/rmpp-lang.rcc.old; } && mv -f /usr/lib/rmpp/rmpp-lang/rmpp-lang.rcc.new /usr/lib/rmpp/rmpp-lang/rmpp-lang.rcc
	cp "/home/root/.vellum/share/rmpp-lang"/rmpp-lang /usr/lib/rmpp/rmpp-lang/rmpp-lang.new && chmod 755 /usr/lib/rmpp/rmpp-lang/rmpp-lang.new && { [ ! -e /usr/lib/rmpp/rmpp-lang/rmpp-lang ] || mv -f /usr/lib/rmpp/rmpp-lang/rmpp-lang /usr/lib/rmpp/rmpp-lang/rmpp-lang.old; } && mv -f /usr/lib/rmpp/rmpp-lang/rmpp-lang.new /usr/lib/rmpp/rmpp-lang/rmpp-lang
	ln -sfn ../rmpp-lang/librmpp-lang.so /usr/lib/rmpp/preload.d/50-rmpp-lang.so
	cp "/home/root/.vellum/share/rmpp-lang"/rmpp-lang.env /usr/lib/rmpp/env.d/rmpp-lang.env.new && chmod 644 /usr/lib/rmpp/env.d/rmpp-lang.env.new && { [ ! -e /usr/lib/rmpp/env.d/rmpp-lang.env ] || mv -f /usr/lib/rmpp/env.d/rmpp-lang.env /usr/lib/rmpp/env.d/rmpp-lang.env.old; } && mv -f /usr/lib/rmpp/env.d/rmpp-lang.env.new /usr/lib/rmpp/env.d/rmpp-lang.env
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

