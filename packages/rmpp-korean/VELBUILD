# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.

package() {
	install -Dm755 "$srcdir"/libhangul.so "$pkgdir"/home/root/.vellum/share/rmpp-korean/libhangul.so
	install -Dm644 "$srcdir"/ko_KR.rcc "$pkgdir"/home/root/.vellum/share/rmpp-korean/ko_KR.rcc

	install -Dm644 "$srcdir"/NotoSansCJKkr-Regular.otf \
		"$pkgdir"/home/root/.local/share/fonts/rmpp-korean/NotoSansCJKkr-Regular.otf
	install -Dm644 "$srcdir"/NotoSansCJKkr-Bold.otf \
		"$pkgdir"/home/root/.local/share/fonts/rmpp-korean/NotoSansCJKkr-Bold.otf

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	install -Dm644 "$srcdir"/OFL-LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/OFL-LICENSE
	echo "https://github.com/$upstream_author/rmpp-korean" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	/home/root/.vellum/bin/mount-rw
	install -Dm755 /home/root/.vellum/share/rmpp-korean/libhangul.so /usr/lib/rmpp-korean/libhangul.so
	install -Dm644 /home/root/.vellum/share/rmpp-korean/ko_KR.rcc /usr/lib/rmpp-korean/ko_KR.rcc
	mkdir -p /usr/lib/rmpp-preload.d
	ln -sf /usr/lib/rmpp-korean/libhangul.so /usr/lib/rmpp-preload.d/50-rmpp-korean.so
	# Files from manual test installs before this package existed
	rm -f /usr/lib/systemd/system/xochitl.service.d/hangul.conf
	rm -rf /usr/lib/hangul
	sync
	/home/root/.vellum/bin/mount-restore
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
}

postupgrade() {
	/home/root/.vellum/bin/mount-rw
	install -Dm755 /home/root/.vellum/share/rmpp-korean/libhangul.so /usr/lib/rmpp-korean/libhangul.so
	install -Dm644 /home/root/.vellum/share/rmpp-korean/ko_KR.rcc /usr/lib/rmpp-korean/ko_KR.rcc
	mkdir -p /usr/lib/rmpp-preload.d
	ln -sf /usr/lib/rmpp-korean/libhangul.so /usr/lib/rmpp-preload.d/50-rmpp-korean.so
	# Files from manual test installs before this package existed
	rm -f /usr/lib/systemd/system/xochitl.service.d/hangul.conf
	rm -rf /usr/lib/hangul
	sync
	/home/root/.vellum/bin/mount-restore
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
}

# `vellum reenable` after an OS update: the root file system is already writable here.
postosupgrade() {
	install -Dm755 /home/root/.vellum/share/rmpp-korean/libhangul.so /usr/lib/rmpp-korean/libhangul.so
	install -Dm644 /home/root/.vellum/share/rmpp-korean/ko_KR.rcc /usr/lib/rmpp-korean/ko_KR.rcc
	mkdir -p /usr/lib/rmpp-preload.d
	ln -sf /usr/lib/rmpp-korean/libhangul.so /usr/lib/rmpp-preload.d/50-rmpp-korean.so
	# Files from manual test installs before this package existed
	rm -f /usr/lib/systemd/system/xochitl.service.d/hangul.conf
	rm -rf /usr/lib/hangul
	sync
}

predeinstall() {
	/home/root/.vellum/bin/mount-rw
	rm -f /usr/lib/rmpp-preload.d/50-rmpp-korean.so
	rm -rf /usr/lib/rmpp-korean
	sync
	/home/root/.vellum/bin/mount-restore
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
}
