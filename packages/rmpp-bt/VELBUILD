category="ui"
pkgdesc="Bluetooth settings page and quick-settings toggle; Bluetooth on at boot (no xovi)"
url="https://github.com/lorancecall/rmpp-bt"
arch="aarch64"
license="GPL-3.0-only"
depends="rmpp-preload>=0.2.0 !rm1 !rm2 mount-utils remarkable-os>=3.29 remarkable-os<3.30 !bluetooth-settings !quicksettings-bluetooth"
source="
https://github.com/$upstream_author/rmpp-bt/releases/download/v$pkgver/librmpp-bt.so
https://github.com/$upstream_author/rmpp-bt/releases/download/v$pkgver/rmpp-bt.rcc
https://raw.githubusercontent.com/$upstream_author/rmpp-bt/v$pkgver/LICENSE
rmpp-bluetooth.service
rmpp-bt-reconnect.service
reconnect
boot
rmpp-bt.env
"
options="!check !fhs !strip"

# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.
# Everything lives in /home (rmpp-preload's one-file layout): library, rcc and reconnect logger in the share folder,
# a link in preload.d, the rcc path in env.d, and a boot hook in boot.d that copies the two units to
# /run/systemd/system (RAM) and starts them at every boot. A factory reset removes it all. Older versions put the
# files in /usr/lib and the units in /usr/lib/systemd/system: removed here.

package() {
	local d="$pkgdir"/home/root/.vellum/share/rmpp-bt
	local p="$pkgdir"/home/root/.vellum/share/rmpp-preload
	install -Dm755 "$srcdir"/librmpp-bt.so "$d"/librmpp-bt.so
	install -Dm644 "$srcdir"/rmpp-bt.rcc "$d"/rmpp-bt.rcc
	install -Dm644 "$srcdir"/rmpp-bluetooth.service "$d"/rmpp-bluetooth.service
	install -Dm644 "$srcdir"/rmpp-bt-reconnect.service "$d"/rmpp-bt-reconnect.service
	install -Dm755 "$srcdir"/reconnect "$d"/reconnect
	install -dm755 "$p"/preload.d
	ln -s ../../rmpp-bt/librmpp-bt.so "$p"/preload.d/50-rmpp-bt.so
	install -Dm644 "$srcdir"/rmpp-bt.env "$p"/env.d/rmpp-bt.env
	install -Dm755 "$srcdir"/boot "$p"/boot.d/50-rmpp-bt

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rmpp-bt" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	if [ -e /usr/lib/rmpp-bt ] || [ -e /usr/lib/systemd/system/rmpp-bluetooth.service ]; then
		/home/root/.vellum/bin/mount-rw
		rm -f /usr/lib/rmpp-preload.d/50-rmpp-bt.so /usr/lib/systemd/system/multi-user.target.wants/rmpp-bluetooth.service
		rm -f /usr/lib/systemd/system/rmpp-bluetooth.service /usr/lib/systemd/system/rmpp-bt-reconnect.service
		rm -rf /usr/lib/rmpp-bt
		sync
		/home/root/.vellum/share/rmpp-preload/boot.d/50-rmpp-bt
		systemctl restart rmpp-bt-reconnect.service 2>/dev/null || true
		systemctl reset-failed xochitl 2>/dev/null || true
		systemctl restart xochitl
		sleep 3
		/home/root/.vellum/bin/mount-restore
	else
		/home/root/.vellum/share/rmpp-preload/boot.d/50-rmpp-bt
		systemctl restart rmpp-bt-reconnect.service 2>/dev/null || true
		systemctl reset-failed xochitl 2>/dev/null || true
		systemctl restart xochitl
	fi
}

postupgrade() {
	if [ -e /usr/lib/rmpp-bt ] || [ -e /usr/lib/systemd/system/rmpp-bluetooth.service ]; then
		/home/root/.vellum/bin/mount-rw
		rm -f /usr/lib/rmpp-preload.d/50-rmpp-bt.so /usr/lib/systemd/system/multi-user.target.wants/rmpp-bluetooth.service
		rm -f /usr/lib/systemd/system/rmpp-bluetooth.service /usr/lib/systemd/system/rmpp-bt-reconnect.service
		rm -rf /usr/lib/rmpp-bt
		sync
		/home/root/.vellum/share/rmpp-preload/boot.d/50-rmpp-bt
		systemctl restart rmpp-bt-reconnect.service 2>/dev/null || true
		systemctl reset-failed xochitl 2>/dev/null || true
		systemctl restart xochitl
		sleep 3
		/home/root/.vellum/bin/mount-restore
	else
		/home/root/.vellum/share/rmpp-preload/boot.d/50-rmpp-bt
		systemctl restart rmpp-bt-reconnect.service 2>/dev/null || true
		systemctl reset-failed xochitl 2>/dev/null || true
		systemctl restart xochitl
	fi
}

predeinstall() {
	systemctl stop rmpp-bt-reconnect.service 2>/dev/null || true
	rm -f /run/systemd/system/rmpp-bluetooth.service /run/systemd/system/rmpp-bt-reconnect.service
	systemctl daemon-reload
}

postdeinstall() {
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/rmpp-bt
	fi
}
