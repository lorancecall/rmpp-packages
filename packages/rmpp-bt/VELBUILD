depends="rmpp-preload !rm1 !rm2 mount-utils remarkable-os>=3.29 remarkable-os<3.30 !bluetooth-settings !quicksettings-bluetooth"
source="
https://github.com/$upstream_author/rmpp-bt/releases/download/v$pkgver/librmpp-bt.so
https://github.com/$upstream_author/rmpp-bt/releases/download/v$pkgver/rmpp-bt.rcc
https://raw.githubusercontent.com/$upstream_author/rmpp-bt/v$pkgver/LICENSE
rmpp-bluetooth.service
rmpp-bt-reconnect.service
reconnect
"
options="!check !fhs !strip"

# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.

package() {
	local d="$pkgdir"/home/root/.vellum/share/rmpp-bt
	install -Dm755 "$srcdir"/librmpp-bt.so "$d"/librmpp-bt.so
	install -Dm644 "$srcdir"/rmpp-bt.rcc "$d"/rmpp-bt.rcc
	install -Dm644 "$srcdir"/rmpp-bluetooth.service "$d"/rmpp-bluetooth.service
	install -Dm644 "$srcdir"/rmpp-bt-reconnect.service "$d"/rmpp-bt-reconnect.service
	install -Dm755 "$srcdir"/reconnect "$d"/reconnect

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rmpp-bt" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	/home/root/.vellum/bin/mount-rw
	s=/home/root/.vellum/share/rmpp-bt
	mkdir -p "$(dirname /usr/lib/rmpp-bt/librmpp-bt.so)"
	cp "$s"/librmpp-bt.so /usr/lib/rmpp-bt/librmpp-bt.so.new && chmod 755 /usr/lib/rmpp-bt/librmpp-bt.so.new && mv -f /usr/lib/rmpp-bt/librmpp-bt.so.new /usr/lib/rmpp-bt/librmpp-bt.so
	mkdir -p "$(dirname /usr/lib/rmpp-bt/rmpp-bt.rcc)"
	cp "$s"/rmpp-bt.rcc /usr/lib/rmpp-bt/rmpp-bt.rcc.new && chmod 644 /usr/lib/rmpp-bt/rmpp-bt.rcc.new && mv -f /usr/lib/rmpp-bt/rmpp-bt.rcc.new /usr/lib/rmpp-bt/rmpp-bt.rcc
	mkdir -p "$(dirname /usr/lib/rmpp-bt/reconnect)"
	cp "$s"/reconnect /usr/lib/rmpp-bt/reconnect.new && chmod 755 /usr/lib/rmpp-bt/reconnect.new && mv -f /usr/lib/rmpp-bt/reconnect.new /usr/lib/rmpp-bt/reconnect
	mkdir -p "$(dirname /usr/lib/systemd/system/rmpp-bluetooth.service)"
	cp "$s"/rmpp-bluetooth.service /usr/lib/systemd/system/rmpp-bluetooth.service.new && chmod 644 /usr/lib/systemd/system/rmpp-bluetooth.service.new && mv -f /usr/lib/systemd/system/rmpp-bluetooth.service.new /usr/lib/systemd/system/rmpp-bluetooth.service
	mkdir -p "$(dirname /usr/lib/systemd/system/rmpp-bt-reconnect.service)"
	cp "$s"/rmpp-bt-reconnect.service /usr/lib/systemd/system/rmpp-bt-reconnect.service.new && chmod 644 /usr/lib/systemd/system/rmpp-bt-reconnect.service.new && mv -f /usr/lib/systemd/system/rmpp-bt-reconnect.service.new /usr/lib/systemd/system/rmpp-bt-reconnect.service
	mkdir -p /usr/lib/systemd/system/multi-user.target.wants /usr/lib/rmpp-preload.d
	ln -sf ../rmpp-bluetooth.service /usr/lib/systemd/system/multi-user.target.wants/rmpp-bluetooth.service
	ln -sf /usr/lib/rmpp-bt/librmpp-bt.so /usr/lib/rmpp-preload.d/50-rmpp-bt.so
	sync
	systemctl daemon-reload
	systemctl start rmpp-bluetooth.service || true
	systemctl restart rmpp-bt-reconnect.service || true
	systemctl daemon-reload
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}

