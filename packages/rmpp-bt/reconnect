#!/bin/sh
# After boot, try to reconnect paired, trusted Bluetooth devices for about a minute.
# Keyboards usually reconnect when a key is pressed; this covers ones that wait for the host.
sleep 5
for n in 1 2 3 4 5 6; do
	pending=0
	for d in $(bluetoothctl devices Trusted | awk '{print $2}'); do
		bluetoothctl info "$d" | grep -q "Connected: yes" && continue
		pending=1
		timeout 8 bluetoothctl connect "$d" >/dev/null 2>&1
	done
	[ "$pending" = 0 ] && exit 0
	sleep 10
done
exit 0
