#!/bin/sh
# rmpp-bt boot hook: rmpp-preload's launcher runs it once per boot (and the package scripts after installing).
# The units go to /run/systemd/system (RAM): nothing on the root file system, gone after a reboot until this runs.
S=/home/root/.vellum/share/rmpp-bt
mkdir -p /run/systemd/system
for u in rmpp-bluetooth.service rmpp-bt-reconnect.service; do
	cp "$S/$u" "/run/systemd/system/$u.new" && mv -f "/run/systemd/system/$u.new" "/run/systemd/system/$u"
done
systemctl daemon-reload
# loads the Bluetooth driver, then starts bluetooth.service and the reconnect logger
systemctl --no-block start rmpp-bluetooth.service
