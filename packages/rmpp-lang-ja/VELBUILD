# Files: /home/root/.local/share/rmpp-lang/languages/ja/ (found by rmpp-lang while it runs)
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.

package() {
	mkdir -p "$pkgdir"/home/root/.local/share/rmpp-lang/languages/ja
	cp -r "$srcdir"/ja/. "$pkgdir"/home/root/.local/share/rmpp-lang/languages/ja/
}

postinstall() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p /usr/lib/rmpp-lang/languages
	sync
	[ -x /usr/bin/rmpp-lang ] && /usr/bin/rmpp-lang lang on ja || true
	/home/root/.vellum/bin/mount-restore
}

postupgrade() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p /usr/lib/rmpp-lang/languages
	sync
	/home/root/.vellum/bin/mount-restore
}

# `vellum reenable` after an OS update: the root file system is already writable here.
postosupgrade() {
	mkdir -p /usr/lib/rmpp-lang/languages
	sync
}

predeinstall() {
	/home/root/.vellum/bin/mount-rw
	rm -f /usr/lib/rmpp-lang/languages/ja.rcc
	sync
	/home/root/.vellum/bin/mount-restore
}
