# Files: /home/root/.local/share/rmpp-lang/languages/zh/ (found by rmpp-lang while it runs)
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.

package() {
	mkdir -p "$pkgdir"/home/root/.local/share/rmpp-lang/languages/zh
	cp -r "$srcdir"/zh/. "$pkgdir"/home/root/.local/share/rmpp-lang/languages/zh/
}

postinstall() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p /usr/lib/rmpp-lang/languages
	sync
	[ -x /usr/bin/rmpp-lang ] && /usr/bin/rmpp-lang lang on zh || true
	/home/root/.vellum/bin/mount-restore
}

postupgrade() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p /usr/lib/rmpp-lang/languages
	sync
	/home/root/.vellum/bin/mount-restore
}

# `vellum reenable` after an OS update: the root file system is already writable here.
postosupgrade() {
	mkdir -p /usr/lib/rmpp-lang/languages
	sync
}

predeinstall() {
	/home/root/.vellum/bin/mount-rw
	rm -f /usr/lib/rmpp-lang/languages/zh.rcc
	sync
	/home/root/.vellum/bin/mount-restore
}
