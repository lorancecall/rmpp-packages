# Files: /home/root/.local/share/rmpp-lang/languages/ru/ (found by rmpp-lang while it runs)
# and ru.rcc (keyboard layouts), copied to /usr/lib/rmpp-lang/languages/: xochitl loads it at start, before /home is mounted
# Never `systemctl stop xochitl`: that powers the tablet off. reset-failed avoids the restart limit.

package() {
	mkdir -p "$pkgdir"/home/root/.local/share/rmpp-lang/languages/ru
	cp -r "$srcdir"/ru/. "$pkgdir"/home/root/.local/share/rmpp-lang/languages/ru/
	install -Dm644 "$srcdir"/ru.rcc "$pkgdir"/home/root/.vellum/share/rmpp-lang-ru/ru.rcc
}

postinstall() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p /usr/lib/rmpp-lang/languages
	cp /home/root/.vellum/share/rmpp-lang-ru/ru.rcc /usr/lib/rmpp-lang/languages/ru.rcc.new && chmod 644 /usr/lib/rmpp-lang/languages/ru.rcc.new && mv -f /usr/lib/rmpp-lang/languages/ru.rcc.new /usr/lib/rmpp-lang/languages/ru.rcc
	sync
	[ -x /usr/bin/rmpp-lang ] && /usr/bin/rmpp-lang lang on ru || true
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}

postupgrade() {
	/home/root/.vellum/bin/mount-rw
	mkdir -p /usr/lib/rmpp-lang/languages
	cp /home/root/.vellum/share/rmpp-lang-ru/ru.rcc /usr/lib/rmpp-lang/languages/ru.rcc.new && chmod 644 /usr/lib/rmpp-lang/languages/ru.rcc.new && mv -f /usr/lib/rmpp-lang/languages/ru.rcc.new /usr/lib/rmpp-lang/languages/ru.rcc
	sync
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}

# `vellum reenable` after an OS update: the root file system is already writable here.
postosupgrade() {
	mkdir -p /usr/lib/rmpp-lang/languages
	cp /home/root/.vellum/share/rmpp-lang-ru/ru.rcc /usr/lib/rmpp-lang/languages/ru.rcc.new && chmod 644 /usr/lib/rmpp-lang/languages/ru.rcc.new && mv -f /usr/lib/rmpp-lang/languages/ru.rcc.new /usr/lib/rmpp-lang/languages/ru.rcc
	sync
}

predeinstall() {
	/home/root/.vellum/bin/mount-rw
	rm -f /usr/lib/rmpp-lang/languages/ru.rcc
	sync
	systemctl reset-failed xochitl 2>/dev/null || true
	systemctl restart xochitl
	sleep 3
	/home/root/.vellum/bin/mount-restore
}
